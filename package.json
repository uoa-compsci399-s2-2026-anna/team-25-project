{
  "name": "casa",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build storybook:build",
    "build:app": "turbo run build --filter='./apps/*'",
    "build:web": "turbo run build --filter=web",
    "build:storybook": "turbo run storybook:build --filter=@repo/ui",
    "dev": "turbo run dev storybook:start",
    "dev:app": "turbo run dev --filter='./apps/*'",
    "dev:web": "turbo run dev --filter=web",
    "dev:storybook": "turbo run storybook:start --filter=@repo/ui",
    "types:check": "turbo types:check",
    "test": "turbo test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:coverage:watch": "turbo run test:coverage:watch",
    "test:coverage:merge": "pnpm --filter @repo/test-config coverage:merge",
    "types:generate": "turbo run generate:types",
    "lint:check": "turbo lint:check",
    "lint:fix": "turbo lint:fix",
    "commitlint": "commitlint --edit",
    "postinstall": "sh -c 'command -v git >/dev/null 2>&1 || exit 0; lefthook install'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@vitest/browser": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/ui": "4.1.10",
    "cross-env": "^7.0.3",
    "lefthook": "^2.1.10",
    "turbo": "^2.9.18",
    "typescript": "^7"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "26.5.1"
  }
}
